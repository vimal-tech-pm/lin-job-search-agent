#!/usr/bin/env bash
# One-shot Lin stage runner with the stage's pinned cron model+provider. Replaces the old
# greenfield/paused-cron dance (cron run re-enables paused jobs — never do that).
# Usage: lin-run <scan|score|stage|build|build-forge|finalize|deep-prep|status|track> [args…] [-m MODEL] [--provider P]
# Examples:
#   lin-run score --greenfield          # backlog drain, score's pinned model
#   lin-run stage --top 25              # stage the 25 best eligible
#   lin-run build                       # build staged folders on the frontier model (dual-path)
#   lin-run build-forge                 # Forge-only fastpath build
#   lin-run build <co/slug> -m deepseek-v4-pro --provider opencode-go   # override model
set -euo pipefail
STAGE="${1:?usage: lin-run <stage> [args…] [-m MODEL] [--provider P]}"; shift
case "$STAGE" in scan|score|stage|build|build-forge|finalize|deep-prep|status|track) ;; *) echo "unknown stage: $STAGE" >&2; exit 2;; esac

# track is pure script — no LLM, run the tracker directly
[ "$STAGE" = track ] && exec node ~/.hermes/profiles/lin/lin/scripts/lin-tracker.mjs

MODEL="" PROVIDER="" ARGS=()
while [ $# -gt 0 ]; do case "$1" in
  -m) MODEL="$2"; shift 2;;
  --provider) PROVIDER="$2"; shift 2;;
  *) ARGS+=("$1"); shift;;
esac; done

if [ -z "$MODEL" ] || [ -z "$PROVIDER" ]; then
  read -r JMODEL JPROVIDER < <(python3 - "$STAGE" <<'EOF'
import json
import os, sys
try:
    jobs = json.load(open(os.path.expanduser("~/.hermes/profiles/lin/cron/jobs.json")))["jobs"]
    j = next((j for j in jobs if j.get("id") == f"lin-{sys.argv[1]}"), None) or {}
except Exception:
    j = {}
print(j.get("model") or "deepseek-v4-flash", j.get("provider") or "opencode-go")
EOF
)
  MODEL="${MODEL:-$JMODEL}"; PROVIDER="${PROVIDER:-$JPROVIDER}"
fi

SKILL="lin-$STAGE"
if [ ${#ARGS[@]} -gt 0 ]; then VERB="${ARGS[*]}"; else
  case "$STAGE" in
    scan) VERB="all";; score) VERB="all";; stage) VERB="auto";;
    build) VERB="batch";; build-forge) VERB="batch";; finalize) VERB="batch";; deep-prep) VERB="run";; status) VERB="check";;
  esac
fi

echo "lin-run: $SKILL on $MODEL ($PROVIDER): $VERB" >&2
exec hermes -p lin chat -q "$SKILL $VERB" -s "$SKILL" -m "$MODEL" --provider "$PROVIDER"
